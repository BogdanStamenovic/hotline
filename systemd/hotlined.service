[Unit]
Description=hotline daemon (HTTP bridge from the phone to Claude Code)
# Wants= not Requires=: a slow or failed tailscaled must delay this, not prevent
# it. The daemon is useful on localhost and to the Discord bot long before the
# tailnet is up, and Requires= would mean one flaky dependency takes the whole
# phone path down.
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=simple
WorkingDirectory=/home/bodas/data/hotline
ExecStart=/home/bodas/data/hotline/.venv/bin/hotlined
Restart=always
RestartSec=5
# The daemon spawns agent sessions in tmux, and whoever starts the tmux server
# owns it: if hotlined is first, the server lands in *this* cgroup and the
# default KillMode=control-group takes it down on every stop, restart or crash.
# The server then SIGHUPs every pane, so one `systemctl restart hotlined`
# destroys every Claude session on the box -- which is exactly what happened on
# 2026-08-24, four sessions and ~6GB of context, including the agent that issued
# the restart. tmuxen puts new servers in their own scope now; this is the
# backstop for a server that is already misplaced.
KillMode=process
# claude reads ~/.claude/.credentials.json and writes the stop spool under
# $XDG_RUNTIME_DIR. A *user* unit gets both for free; a system unit with
# User=bodas would need XDG_RUNTIME_DIR set by hand, and getting it wrong means
# the Stop hook and the daemon disagree about where the spool lives.
Environment=PATH=/home/bodas/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
